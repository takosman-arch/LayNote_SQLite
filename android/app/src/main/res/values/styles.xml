<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- image_cropper (uCrop) fotoğraf kırpma ekranının teması. Ayrı bir
         stil olarak tanımlanmasının nedeni: values-v35/styles.xml içinde
         Android 15+ (API 35+) için aynı isimle üzerine yazılıp
         edge-to-edge opt-out bayrağının eklenmesi — bkz. o dosyadaki not.
         Bu dosyadaki (varsayılan) sürüm API 35'in altındaki cihazlar için
         kullanılır ve eski davranıştan (Theme.AppCompat.Light.NoActionBar)
         farksızdır. -->
    <style name="Ucrop.CropTheme" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- NoteWidgetConfigActivity (widget ekleme/görünüm ayarları ekranı)
         için: pencereyi gerçekten saydam yapıp, 2. adımdaki (görünüm
         ayarları) önizleme kutusunun arkasında sistemin GERÇEK duvar
         kağıdının görünmesine izin veren tema.
         ÖNEMLİ: Sadece NoteWidgetConfigActivity.kt içindeki runtime
         çağrıları (window.addFlags(FLAG_SHOW_WALLPAPER) /
         setBackgroundDrawable(null) / setFormat(PixelFormat.TRANSLUCENT))
         YETERLİ DEĞİL — pencerenin saydam mı opak mı bir surface olarak
         kurulacağına sistem çoğunlukla Activity'nin onCreate() KODU
         ÇALIŞMADAN ÖNCE, bu temaya bakarak karar veriyor. Bu yüzden asıl
         garanti kaynağı burasıdır; Kotlin tarafındaki çağrılar bunu
         tamamlayıcı/pekiştirici olarak kalıyor, kaldırılmalarına gerek yok. -->
    <style name="Theme.NoteWidgetConfig" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- DÜZELTME (starting window flaşı): overrideActivityTransition(...,0,0)
             sadece Activity GEÇİŞ animasyonunu (cross-fade) kapatıyor;
             onCreate() çalışmadan ÖNCE sistemin çizdiği ayrı "starting
             window" karesini etkilemiyor. Translucent+showWallpaper
             temalarda sistem bu starting window'u genelde altındaki
             ekranın (ana ekran + widget) bir anlık görüntüsüyle
             dolduruyor — flaş olarak görülen budur. windowDisablePreview,
             starting window için bu önizlemeyi tamamen devre dışı
             bırakır: pencere boş/saydam başlar, kod çizene kadar widget
             dahil hiçbir şey görünmez. Zaten yapılandırılmış bir
             widget'tan doğrudan 2. adıma (görünüm ayarları — RecyclerView,
             kare önizleme, duvar kağıdı çizimi) girildiğinde ilk gerçek
             karenin çizilmesi daha uzun sürdüğü için starting window'un
             görünür kaldığı süre de uzuyor; bu yüzden flaş özellikle
             burada fark ediliyor. -->
        <item name="android:windowDisablePreview">true</item>
        <!-- Pencerenin kendisini opak değil, saydam (translucent) bir
             surface olarak oluşturmasını sağlar — asıl kritik satır bu. -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- Sistem duvar kağıdının bu pencerenin arkasında çizilmesine
             izin verir (FLAG_SHOW_WALLPAPER'ın tema karşılığı). -->
        <item name="android:windowShowWallpaper">true</item>
        <!-- Pencerenin varsayılan (genelde opak) arka planını kaldırır;
             asıl gerçek renkler zaten Kotlin tarafında (headerRow,
             bottomHalf, addWidgetBtn, previewCard) tek tek veriliyor. -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- Sistemin "arka plan önbelleği" optimizasyonu, saydam
             pencerelerde yanlışlıkla opak bir renk varsayabiliyor; null
             vererek bunu devre dışı bırakıyoruz. -->
        <item name="android:colorBackgroundCacheHint">@null</item>
        <!-- Saydam pencerelerde varsayılan içerik gölgesi/overlay'i
             istemiyoruz. -->
        <item name="android:windowContentOverlay">@null</item>
        <!-- 1. ekrandaki (not seçimi) tam ekran liste de bu temayı
             kullanacağından (aynı Activity), o ekranda görsel bir fark
             olmasın diye giriş/çıkış animasyonu sistem varsayılanında
             bırakılıyor; windowIsTranslucent=true bazı OEM'lerde
             varsayılan geçiş animasyonunu "dialog" tarzına çevirebiliyor,
             bunu engellemek için normal pencere animasyonu zorlanıyor. -->
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
</resources>
