<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget'ın gerçek görünümü - klasik RemoteViews layout'u.
  widget_lines_container artık bir ListView: RemoteViews'te kaydırma
  desteği YALNIZCA ListView/GridView/StackView üzerinden mümkün
  (ScrollView hiçbir API seviyesinde desteklenmez). Satırları artık
  NoteWidgetRemoteViewsService (RemoteViewsFactory) üretiyor.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Henüz not yok" />

        <TextView
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0B0B0"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!--
          layout_height=0dp + layout_weight=1 ŞART: ListView'e ölçülebilir
          bir yükseklik verir, aksi halde wrap_content ile tüm satırları
          birden göstermeye çalışır ve kaydırma hiç işlemez.
        -->
        <ListView
            android:id="@+id/widget_lines_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B0B0B0"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
