<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget'ın gerçek görünümü - klasik RemoteViews layout'u.
  widget_lines_container artık bir ListView: RemoteViews'te kaydırma
  desteği YALNIZCA ListView/GridView/StackView üzerinden mümkün
  (ScrollView hiçbir API seviyesinde desteklenmez). Satırları artık
  NoteWidgetRemoteViewsService (RemoteViewsFactory) üretiyor.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
          DÜZELTME (2 yeni ikon): Başlık artık tek başına değil, sağ
          üstteki ⚙️ (ayarlar -> NoteWidgetConfigActivity) ve ➕ (yeni not
          -> dnote://newnote) ikonlarıyla AYNI yatay satırda. Başlık
          layout_weight="1" ile kalan tüm genişliği alıyor (0dp + weight),
          ikonlar sabit boyutta kalıyor — böylede uzun başlıklar ikonların
          ÜSTÜNE binmek yerine kendi (ellipsize) ile kısalıyor.
          Tıklama davranışı burada DEĞİL, NoteWidgetReceiverV2.kt'de
          (setOnClickPendingIntent, widget_root'unkinden BAĞIMSIZ olarak
          bu iki view'a özel) tanımlanıyor.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Henüz not yok" />

            <!-- DÜZELTME (ikon sırası değiştirildi): ➕ artık başlığa daha
                 yakın (soldaki), ⚙️ ayar ikonu en sağda. marginStart
                 değerleri de sıraya göre swap edildi: ilk ikonun
                 (widget_add_button) başlıkla arasındaki boşluk eskiden
                 widget_settings_button'ın sahip olduğu 4dp; ikinci ikonun
                 (widget_settings_button) kendinden önceki ikonla arasındaki
                 boşluk ise eskiden widget_add_button'ın sahip olduğu 2dp —
                 böylece görsel aralıklar aynı kalıyor, sadece hangi ikonun
                 nerede olduğu değişiyor. NoteWidgetConfigActivity.kt'deki
                 previewAddIcon/previewSettingsIcon sırası da AYNI şekilde
                 güncellendi (önizleme <-> gerçek widget birebir eşleşsin). -->
            <ImageView
                android:id="@+id/widget_add_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:padding="4dp"
                android:src="@drawable/ic_widget_add"
                android:contentDescription="@string/widget_add_button_desc" />

            <ImageView
                android:id="@+id/widget_settings_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:padding="4dp"
                android:src="@drawable/ic_widget_settings"
                android:contentDescription="@string/widget_settings_button_desc" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0B0B0"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!--
          layout_height=0dp + layout_weight=1 ŞART: ListView'e ölçülebilir
          bir yükseklik verir, aksi halde wrap_content ile tüm satırları
          birden göstermeye çalışır ve kaydırma hiç işlemez.
        -->
        <ListView
            android:id="@+id/widget_lines_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B0B0B0"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
