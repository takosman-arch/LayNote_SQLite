<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hatırlatıcı bildirimleri için gerekli izinler -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Not içine ses kaydı ekleyebilmek için mikrofon izni -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Not içine video çekip ekleyebilmek için kamera izni -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- "Albüme Kaydet" özelliği (gal paketi) için — yalnızca Android 10
         (API 29) ve altında gerekli; Android 11+ galeriye kayıt için özel
         bir izin gerektirmiyor. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <!-- Kamerası olmayan cihazlarda da (nadiren) uygulamanın Play Store'da
         görünmeye devam etmesi için "zorunlu değil" olarak işaretlendi. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <application
        android:label="Layout"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Başka bir uygulamadan "Paylaş" ile link/metin gönderilmesini
                 yakalamak için (receive_sharing_intent paketi). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
        </activity>

        <!-- image_cropper paketinin (fotoğraf kırpma ekranı) Android'de
             kullandığı uCrop kütüphanesinin kırpma Activity'si. Bu
             tanımlanmazsa "Unable to find explicit activity class
             ...UCropActivity" hatasıyla kırpma ekranı hiç açılmadan
             uygulama çöküyor. exported gerekmiyor: yalnızca uygulamanın
             kendisi bu Activity'yi startActivityForResult ile açıyor. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Cihaz yeniden başladığında planlanmış hatırlatıcıların
             (flutter_local_notifications) kaybolmaması için gerekli
             receiver'lar. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Bildirimlerdeki aksiyon butonlarına (ör. bildirim paneline
             sabitlenmiş notlardaki "Kaldır" butonu) dokunulduğunda
             sistemin bunu Dart tarafına (foreground/arka plan işleyicilere)
             iletebilmesi için gerekli receiver. Bu olmadan aksiyon
             butonlarına dokunmak hiçbir şey yapmaz. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />

        <!-- Ana ekran widget'ı (Glance) receiver kaydı. exported="true"
             ZORUNLU: Android widget receiver'ları sistemden (launcher/
             AppWidgetManager) gelen APPWIDGET_UPDATE broadcast'ini ancak
             exported=true ise alabilir. exported=false olduğunda widget
             ekleniyor ama sistem gerçek güncellemeyi hiç iletemediği için
             Compose içeriği (NoteWidget.kt) asla render edilmiyor ve widget
             note_widget_loading.xml'deki spinner'da takılı kalıyor —
             "widget ekleniyor ama içinde yazı yok" şikayetinin sebebi buydu.
             android:permission="android.permission.BIND_APPWIDGET" GEREKMEZ,
             bu izin AppWidgetManager tarafında otomatik yönetilir; sadece
             exported=true yeterlidir. -->
        <receiver
            android:name=".NoteWidgetReceiverV2"
            android:exported="true"
            android:label="@string/note_widget_picker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/note_widget_info" />
        </receiver>

        <!-- Widget'ın kaydırılabilir satır listesi (ListView) için veri
             sağlayıcı servis (RemoteViewsFactory). android:permission
             ZORUNLU — sistemin bu servise bağlanabilmesi için;
             android:exported="false" — sadece sistem/kendi uygulamamız
             bağlanabilsin diye. -->
        <service
            android:name=".NoteWidgetRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Widget ana ekrana eklenirken kullanıcının hangi notu göstermek
             istediğini seçmesini sağlayan yapılandırma ekranı (bkz.
             note_widget_info.xml'deki android:configure özniteliği).
             exported="true" ZORUNLU: sistem (launcher) bu Activity'yi
             kendi sürecinden başlatır. -->
        <activity
            android:name=".NoteWidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- "Yeni Not Ekle" ikon widget'ı. Yapılandırma ekranı yok — hangi
             notun gösterileceği gibi bir seçim söz konusu değil, sürükleyip
             bırakınca doğrudan eklenir. exported="true" ZORUNLU: yukarıdaki
             NoteWidgetReceiverV2 açıklamasındaki aynı sebepten — sistemden
             gelen APPWIDGET_UPDATE broadcast'i ancak exported=true ise
             alınabilir. -->
        <receiver
            android:name=".NewNoteWidgetReceiver"
            android:exported="true"
            android:label="@string/new_note_widget_picker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/new_note_widget_info" />
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Google Translate'in cihazda yüklü olup olmadığını kontrol edebilmek
             için (özel metin seçim menüsündeki "Çevir" butonunun ikonu). -->
        <package android:name="com.google.android.apps.translate" />
        <!-- url_launcher'ın https bağlantılarını açabilmesi için (Android 11+). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- speech_to_text paketinin (Sesi Yazıya Çevir özelliği) konuşma
             tanıma servisine bağlanabilmesi için (Android 11+ paket
             görünürlüğü kısıtlaması olmadan "bind to recognition service
             failed" hatası alınabiliyor). -->
        <package android:name="com.google.android.googlequicksearchbox" />
        <!-- flutter_tts paketinin (Yüksek Sesle Oku özelliği) cihazdaki
             metinden sese motorlarını bulabilmesi için (Android 11+ paket
             görünürlüğü kısıtlaması). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
